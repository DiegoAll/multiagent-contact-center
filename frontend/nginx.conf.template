server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

    # La clave de la API vive solo aquí: el navegador nunca la ve.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 95s;
    }

    location / {
        try_files $uri /index.html;
    }
}
