# Copia este archivo a `.env` y completa los valores. `.env` NO se versiona.
#   cp .env.example .env
#
# Los marcados como OBLIGATORIO hacen que `docker compose up` falle si faltan,
# a propósito: vacío desactivaría la autenticación entre servicios.

# --- Secretos compartidos (OBLIGATORIO) ---------------------------------------
# Genera valores aleatorios alfanuméricos, p. ej.:  openssl rand -hex 24
# Usa solo letras y números: se interpolan en URLs y en la config de nginx.
INTERNAL_TOKEN=
API_KEY=
POSTGRES_PASSWORD=

# Token señuelo para detectar fuga del prompt de sistema (OBLIGATORIO). Usa un
# valor propio, p. ej.:  echo CANARY-$(openssl rand -hex 8)
CANARY_TOKEN=

# --- LLM ----------------------------------------------------------------------
# openai | deepseek (DeepSeek usa API compatible con OpenAI y es más económico).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek NO ofrece embeddings. Con LLM_PROVIDER=deepseek mantén
# EMBEDDINGS_PROVIDER=openai (requiere OPENAI_API_KEY) o usa `hash` (offline,
# solo pruebas: embeddings léxicos, no semánticos).
EMBEDDINGS_PROVIDER=openai

# --- Observabilidad (LangSmith, opcional) -------------------------------------
# Con tracing activo, prompts y respuestas se envían a LangSmith (servicio de
# terceros). El agente no envía el email en claro, pero el texto del chat sí
# viaja: evita enviar datos personales reales.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multiagent

# --- Otros --------------------------------------------------------------------
RATE_LIMIT_PER_MIN=60
INGEST_ON_STARTUP=true
